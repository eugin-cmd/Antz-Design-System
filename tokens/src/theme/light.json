    },
    "accent": {
      "$type": "shadow",
      "$value": "0 10px 22px -12px rgba(55, 189, 105, .85)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "hairline": {
      "$type": "shadow",
      "$value": "inset 0 0 0 1px var(--color-border)",
