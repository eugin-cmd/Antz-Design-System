        }
      }
    },
    "launch-slate": {
      "$type": "gradient",
      "$value": "linear-gradient(135deg, var(--color-launch-slate-start) 30%, var(--color-launch-slate-end) 140%)",
      "$description": "Round module tile (launcher), white icon.",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "launch-coral": {
      "$type": "gradient",
      "$value": "linear-gradient(135deg, var(--color-launch-coral-start) 30%, var(--color-launch-coral-end) 140%)",
      "$description": "Round module tile (launcher), white icon.",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "scrim-side": {
      "$type": "gradient",
      "$value": "linear-gradient(90deg, color-mix(in srgb, var(--sage-5) 78%, transparent) 0%, color-mix(in srgb, var(--sage-5) 42%, transparent) 50%, transparent 82%)",
      "$description": "Photo hero: darkens the left of a photo so white text reads (title, stats).",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "fade-end": {
      "$type": "gradient",
      "$value": "linear-gradient(90deg, black calc(100% - 40px), transparent)",
      "$description": "Mask for horizontally scrolling strips: fades the last 40px so more content is hinted.",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "peach": {
      "$type": "gradient",
      "$value": "linear-gradient(130deg, var(--coral-90) 0%, var(--coral-border) 50%, var(--coral-80) 100%)",
      "$description": "Peach fill, tuned to Antz Home style 7: coral 90 to 80, with --color-peach-* text. Identity, never status."
    },
    "maroon": {
      "$type": "gradient",
      "$value": "linear-gradient(150deg, var(--coral-10) 0%, var(--coral-20) 60%, var(--coral-25) 100%)",
      "$description": "Dark warm hero fill (for example the Mortality module hero), white text. Pair with --texture-rings."
    },
    "butter": {
      "$type": "gradient",
      "$value": "linear-gradient(140deg, var(--amber-95) 0%, var(--amber-90) 50%, var(--amber-80) 100%)",
      "$description": "Widget fill: soft amber, with --color-butter-* text. Identity (for example Lab, Favourites), never status."
    },
    "band-ink": {
      "$type": "gradient",
      "$value": "linear-gradient(140deg, var(--charcoal-700) 0%, var(--ink-900) 100%)",
      "$description": "Dark band hero fill: ink. White text. Pair with --texture-rings."
    },
    "class-card": {
      "$type": "gradient",
      "$value": "linear-gradient(135deg, color-mix(in srgb, var(--c, var(--hue-green)) 10%, var(--color-surface)), var(--color-surface) 70%)",
      "$description": "Class card: a soft tint of the class hue (--c) fading to the surface. Identity only."
    },
    "band-lagoon": {
      "$type": "gradient",
      "$value": "radial-gradient(70% 120% at 100% 0%, color-mix(in srgb, var(--lagoon-80) 30%, transparent), transparent 60%), linear-gradient(125deg, var(--lagoon-15), var(--lagoon-30))",
      "$description": "Band hero (lagoon): the default dark band of module homes, with a soft glow top right. White text. Pair with --texture-rings."
    },
    "band-green": {
      "$type": "gradient",
      "$value": "radial-gradient(70% 120% at 100% 0%, color-mix(in srgb, var(--green-60) 28%, transparent), transparent 60%), linear-gradient(140deg, var(--green-20) 0%, var(--green-30) 60%, var(--green-35) 100%)",
      "$description": "Band (green): a deep green card or hero with a soft glow top right, for example the dispense detail sheet. White text. Identity, never status."
    },
    "band-wine": {
      "$type": "gradient",
      "$value": "linear-gradient(150deg, var(--wine-10) 0%, var(--wine-20) 55%, var(--wine-30) 100%)",
      "$description": "Band hero (wine): a red-based crimson band. White text. Identity (for example Fetal death), never status."
    },
    "band-bronze": {
