      "$type": "shadow",
      "$value": "none",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "xs": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(0, 0, 0, .08)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "sm": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(0, 60, 30, .05), 0 14px 30px -22px rgba(0, 60, 30, .45)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "md": {
      "$type": "shadow",
      "$value": "0 2px 4px rgba(20, 40, 30, .05), 0 18px 34px -18px rgba(20, 40, 30, .45)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": "0 30px 70px -24px rgba(0, 40, 20, .5), 0 0 0 1px var(--color-border-subtle)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "xl": {
      "$type": "shadow",
      "$value": "0 40px 90px -30px rgba(0, 40, 20, .55)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "float": {
      "$type": "shadow",
      "$value": "0 18px 40px -18px rgba(0, 40, 20, .45)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "edge": {
      "$type": "shadow",
      "$value": "12px 0 18px -10px rgba(16, 40, 30, .3)",
      "$description": "A soft shadow cast sideways from a pinned edge, for example the first column of a wide table as the others scroll under it."
    },
    "accent": {
      "$type": "shadow",
      "$value": "0 10px 22px -12px rgba(55, 189, 105, .85)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "hairline": {
      "$type": "shadow",
      "$value": "inset 0 0 0 1px var(--color-border)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    }
  },
  "gradient": {
    "$description": "Tiered gradients. Wash = the four reference SVGs (large soft backgrounds, dark text only). Module = identity tiles. Feature = dark cards with large figures. Ad hoc gradients are not allowed.",
    "wash-primary": {
      "$type": "gradient",
      "$value": "linear-gradient(to bottom right, var(--gradient-stop-mint), var(--gradient-stop-rose))",
      "$description": "Gradient 1. Hero and welcome bands, dashboard header, onboarding. Same hue as the brand",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "wash-celebrate": {
      "$type": "gradient",
      "$value": "linear-gradient(to bottom right, var(--gradient-stop-butter), var(--gradient-stop-rose))",
      "$description": "Gradient 2. Announcements, featured cards, milestones",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "wash-calm": {
      "$type": "gradient",
      "$value": "linear-gradient(to bottom right, var(--gradient-stop-butter), var(--gradient-stop-aqua))",
      "$description": "Gradient 3. Info panels, tips, empty states",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "wash-illustrative": {
      "$type": "gradient",
      "$value": "linear-gradient(to bottom right, var(--gradient-stop-sky), var(--gradient-stop-pink))",
      "$description": "Gradient 4. Illustrations, onboarding, docs, marketing",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "iridescent": {
      "$type": "gradient",
      "$value": "linear-gradient(115deg, var(--scale-secondary-400), var(--violet-70), var(--scale-error-300), var(--scale-caution-300), var(--scale-primary-400), var(--scale-info-400), var(--scale-secondary-400))",
      "$description": "Holographic sheen from the colour scales: an ambient accent on dark photo heroes only, drifted slowly (background-size 300%), feathered with --gradient-feather-corner. Never behind text, never on components."
    },
    "feather-corner": {
      "$type": "gradient",
      "$value": "radial-gradient(ellipse 42% 115% at 100% 100%, black 0%, color-mix(in srgb, black 55%, transparent) 40%, transparent 70%)",
      "$description": "Mask, not a colour: strongest in the bottom-right corner, feathering off towards the left and top. Use as mask-image."
    },
    "module-green-navy": {
      "$type": "gradient",
      "$value": "linear-gradient(135deg, var(--green-brand), var(--navy-25))",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "module-teal-green": {
      "$type": "gradient",
      "$value": "linear-gradient(135deg, var(--teal-80), var(--green-brand))",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "module-cyan-navy": {
      "$type": "gradient",
      "$value": "linear-gradient(135deg, var(--sky-60), var(--navy-25))",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "module-coral-red": {
      "$type": "gradient",
      "$value": "linear-gradient(135deg, var(--coral-brand), var(--red-50))",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "module-yellow-cyan": {
      "$type": "gradient",
      "$value": "linear-gradient(135deg, var(--amber-brand), var(--sky-brand))",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "deep": {
      "$type": "gradient",
      "$value": "linear-gradient(140deg, var(--green-15) 0%, var(--green-25) 55%, var(--green-40) 100%)",
      "$description": "Feature: white and highlight text pass AA on every stop",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "green": {
      "$type": "gradient",
      "$value": "linear-gradient(135deg, var(--green-25) 0%, var(--green-40) 60%, var(--green-50) 100%)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "navy": {
      "$type": "gradient",
      "$value": "linear-gradient(140deg, var(--navy-20) 0%, var(--navy-brand) 55%, var(--navy-35) 100%)",
      "$description": "Feature: tertiary feature card",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "teal": {
      "$type": "gradient",
      "$value": "linear-gradient(140deg, var(--lagoon-40) 0%, var(--lagoon-35) 50%, var(--lagoon-25) 100%)",
      "$description": "Teal fill (lagoon family): widgets and cards, white text. Deep enough that white text keeps 4.5:1. Identity, never status."
    },
    "blue": {
      "$type": "gradient",
      "$value": "radial-gradient(130% 90% at 100% 0%, var(--sky-40) 0%, var(--sky-35) 65%, var(--sky-30) 100%)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "mint": {
      "$type": "gradient",
      "$value": "linear-gradient(130deg, var(--mint-97) 0%, var(--mint-92) 45%, var(--mint-88) 100%)",
      "$description": "Mint fill (vivid mint family): widgets and cards, with --color-text-on-bright. Identity, never status."
    },
    "glow": {
      "$type": "gradient",
      "$value": "radial-gradient(70% 85% at 100% 100%, var(--wash-mint) 0%, color-mix(in srgb, var(--wash-mint) 45%, transparent) 40%, transparent 75%)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "aurora": {
      "$type": "gradient",
      "$value": "radial-gradient(42% 110% at 0% 100%, color-mix(in srgb, var(--lagoon-mist) 75%, transparent), transparent 72%), radial-gradient(36% 95% at 32% 108%, color-mix(in srgb, var(--mint-key) 85%, transparent), transparent 72%), radial-gradient(30% 75% at 92% 62%, color-mix(in srgb, var(--coral-border) 60%, transparent), transparent 75%)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "scrim-photo": {
      "$type": "gradient",
      "$value": "linear-gradient(180deg, transparent 38%, color-mix(in srgb, var(--sage-5) 45%, transparent) 62%, color-mix(in srgb, var(--sage-5) 88%, transparent) 100%)",
      "$description": "Overlay: text over photography only",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "tone-panel": {
      "$type": "gradient",
      "$value": "linear-gradient(90deg, transparent 48%, var(--color-surface-raised) 100%), linear-gradient(180deg, var(--color-tone-a), var(--color-tone-b))",
      "$description": "Navigation drawer background: the module tint, top to bottom, fading to the surface on the right.",
      "$extensions": {
        "com.antz": {
          "format": "css",
          "scope": "tone"
        }
      }
    },
    "tone-tab": {
      "$type": "gradient",
      "$value": "linear-gradient(90deg, color-mix(in srgb, var(--color-tone-ta), var(--color-tone-tb)) 0%, color-mix(in srgb, var(--color-tone-ta) 55%, transparent) 40%, transparent 100%)",
      "$description": "Active rail tab: opens from the tab into the panel.",
      "$extensions": {
        "com.antz": {
          "format": "css",
          "scope": "tone"
        }
      }
    },
    "tone-tab-corners": {
      "$type": "gradient",
      "$value": "radial-gradient(circle at 100% 100%, transparent calc(var(--radius-lg) - var(--border-width-hairline)), var(--color-surface-raised) var(--radius-lg)) var(--space-2) 0 / var(--radius-lg) var(--radius-lg) no-repeat, radial-gradient(circle at 100% 0, transparent calc(var(--radius-lg) - var(--border-width-hairline)), var(--color-surface-raised) var(--radius-lg)) var(--space-2) 100% / var(--radius-lg) var(--radius-lg) no-repeat",
      "$description": "Active rail tab: rail white in the two corner squares outside its left radius, so the corners read as true curves on any tone. A background layer list (position and size included).",
      "$extensions": {
        "com.antz": {
          "format": "css",
          "scope": "tone"
        }
      }
    },
    "tone-band": {
      "$type": "gradient",
      "$value": "linear-gradient(180deg, transparent 30%, var(--color-bg-app) 100%), linear-gradient(90deg, var(--color-tone-a), var(--color-tone-b))",
