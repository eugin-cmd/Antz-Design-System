  "shadow": {
    "none": {
      "$type": "shadow",
      "$value": "none",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "xs": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(0, 0, 0, .08)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "sm": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(0, 60, 30, .05), 0 14px 30px -22px rgba(0, 60, 30, .45)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "md": {
      "$type": "shadow",
      "$value": "0 2px 4px rgba(20, 40, 30, .05), 0 18px 34px -18px rgba(20, 40, 30, .45)",
