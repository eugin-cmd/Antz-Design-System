      "$extensions": {
        "com.antz": {
          "format": "css",
          "scope": "tone"
        }
      }
    },
    "text-brand": {
      "$type": "gradient",
      "$value": "linear-gradient(90deg, var(--color-text-gradient-start) 0%, var(--color-text-gradient-mid) 52%, var(--color-text-gradient-end) 100%)",
