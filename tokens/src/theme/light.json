  "gradient": {
    "$description": "Tiered gradients. Wash = the four reference SVGs (large soft backgrounds, dark text only). Module = identity tiles. Feature = dark cards with large figures. Ad hoc gradients are not allowed.",
    "wash-primary": {
      "$type": "gradient",
      "$value": "linear-gradient(to bottom right, var(--gradient-stop-mint), var(--gradient-stop-rose))",
      "$description": "Gradient 1. Hero and welcome bands, dashboard header, onboarding. Same hue as the brand",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
