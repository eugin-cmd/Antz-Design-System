  "texture": {
    "rings": {
      "$type": "gradient",
      "$value": "repeating-radial-gradient(circle at -20% 135%, transparent 0 15px, color-mix(in srgb, white 5.5%, transparent) 15px 16px)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    }
  },
  "gradient-stop": {
