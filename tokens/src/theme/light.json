    },
    "launch-sky": {
      "$type": "gradient",
      "$value": "linear-gradient(135deg, var(--color-launch-sky-start) 30%, var(--color-launch-sky-end) 140%)",
      "$description": "Round module tile (launcher), white icon.",
      "$extensions": {
        "com.antz": {
