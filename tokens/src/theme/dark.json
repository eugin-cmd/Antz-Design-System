  "shadow": {
    "xs": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(0, 0, 0, .4)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "sm": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(0, 0, 0, .3), 0 14px 30px -22px rgba(0, 0, 0, .8)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "md": {
      "$type": "shadow",
      "$value": "0 2px 4px rgba(0, 0, 0, .3), 0 18px 34px -18px rgba(0, 0, 0, .8)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": "0 30px 70px -24px rgba(0, 0, 0, .8), 0 0 0 1px var(--color-border)",
      "$extensions": {
        "com.antz": {
          "format": "css"
        }
      }
    },
    "xl": {
      "$type": "shadow",
      "$value": "0 40px 90px -30px rgba(0, 0, 0, .85), 0 0 0 1px var(--color-border)",
